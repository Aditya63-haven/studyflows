# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/studyflows

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Profile picture storage (relative paths resolve from the backend working directory)
AVATAR_STORAGE_DIR=storage/avatars

# AI provider: mock | external | gemini | openai-compatible
# mock: deterministic local behavior, no credentials.
# external: legacy StudyFlows HTTP contract.
# gemini: native Google Gen AI SDK.
# openai-compatible: any service exposing /chat/completions.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Examples (uncomment one provider block):
# DeepSeek:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
# AI_API_KEY=replace-with-deepseek-api-key
#
# OpenAI:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=replace-with-openai-api-key
#
# Gemini OpenAI-compatible endpoint:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.8-flash
# AI_API_KEY=replace-with-gemini-api-key
#
# Native Gemini:
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.8-flash
# AI_API_KEY=replace-with-gemini-api-key

# Optional OpenAI-compatible request tuning. Leave unset unless your provider supports it.
# AI_JSON_RESPONSE_FORMAT=none
# AI_REASONING_EFFORT=
# AI_EXTRA_REQUEST_PARAMS=

# Email that can manage invite-only AI assistant access.
# The registered account with this email is also granted access automatically.
AI_ACCESS_ADMIN_EMAIL=

# AI safety and usage limits
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_NOTE_CHARS=4000
AI_MAX_DOCUMENT_CONTEXT_CHARS=6000
AI_MAX_HISTORY_MESSAGES=12
AI_USER_REQUESTS_PER_MINUTE=12
AI_GLOBAL_REQUESTS_PER_MINUTE=60
AI_REQUEST_TIMEOUT_MS=30000

# Revision strategy: sm2 | simple
REVISION_STRATEGY=sm2

# Academic document ingestion (PDF, DOCX, TXT, Markdown)
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=300
DOCUMENT_MAX_EXTRACTED_CHARS=500000
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_MAX_CHUNKS=2000
DOCUMENT_STORAGE_DIR=storage/documents
