# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/studyflows

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI provider: mock | external
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=

# Revision strategy: sm2 | simple
REVISION_STRATEGY=sm2
